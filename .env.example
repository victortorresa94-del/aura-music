# Músico de sesión en la nube (ACE-Step 1.5). Sin URL, «Con IA» sale como «Sin conectar».
# De verdad: ACE-Step en una GPU de RunPod con scripts/acestep-gpu.sh, que te da
# estas dos líneas (https://<ID-DEL-POD>-8001.proxy.runpod.net y la clave).
# Paso a paso en docs/ACESTEP.md.
# De prueba, sin GPU: npm run ia:falso y ACESTEP_API_URL=http://localhost:8001
# (no es IA: toca siempre la misma nota, y la app lo dice).
ACESTEP_API_URL=
ACESTEP_API_KEY=
# Tiene que ser un modelo base: los turbo no saben hacer la tarea lego.
ACESTEP_MODEL=acestep-v15-base
ACESTEP_PASOS=32

# El productor piensa con Claude. Sin clave, la hoja del productor lo dice y
# todo lo demás sigue funcionando. Solo en el servidor, nunca NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Opcional: otro modelo para el productor (por defecto claude-opus-5-5).
PRODUCTOR_MODELO=

# Candado del enlace público: si tiene valor, el productor y la IA piden este
# código una vez en cada móvil. Ponlo SIEMPRE antes de poner claves en Vercel.
AURA_MUSIC_CODIGO=
