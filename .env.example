# Músico de sesión en la nube (ACE-Step 1.5). Sin URL, «Con IA» sale como «Sin conectar».
# De verdad: ACE-Step en una GPU de RunPod con scripts/acestep-gpu.sh, que te da
# estas dos líneas (https://<ID-DEL-POD>-8001.proxy.runpod.net y la clave).
# Paso a paso en docs/ACESTEP.md.
# De prueba, sin GPU: npm run ia:falso y ACESTEP_API_URL=http://localhost:8001
# (no es IA: toca siempre la misma nota, y la app lo dice).
ACESTEP_API_URL=
ACESTEP_API_KEY=
# Tiene que ser un modelo base: los turbo no saben hacer la tarea lego.
ACESTEP_MODEL=acestep-v15-base
ACESTEP_PASOS=32

# El productor piensa con Claude. Sin clave, la hoja del productor lo dice y
# todo lo demás sigue funcionando. Solo en el servidor, nunca NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Opcional: otro modelo para el productor (por defecto claude-opus-5-5).
PRODUCTOR_MODELO=

# Candado del enlace público: si tiene valor, el productor y la IA piden este
# código una vez en cada móvil. Ponlo SIEMPRE antes de poner claves en Vercel.
AURA_MUSIC_CODIGO=

# Encender y apagar la GPU desde la app («Encender la GPU»). La clave se crea
# en RunPod → Settings → API Keys (con permiso sobre los pods) y el ID es el
# del pod (sale en su ficha). Con esto, ACESTEP_API_URL es
# https://<RUNPOD_POD_ID>-8001.proxy.runpod.net y ACESTEP_API_KEY la inventas
# tú: la app se la pasa al pod al arrancar ACE-Step. El pod se apaga solo
# tras 15 minutos sin pedidos.
RUNPOD_API_KEY=
RUNPOD_POD_ID=

# Tu cuenta de Aura y las ideas en la nube (pilar D). Es la configuración web
# del Firebase de Aura (proyecto aether-app-59bd1): pública por diseño, la
# lleva el JavaScript de cualquier web con Firebase y no abre nada sola (lo
# que protege tus ideas son las reglas de Aura). Sin estas seis, la app no
# enseña la cuenta y todo se queda en el móvil, como siempre.
# Pasos para ponerlas en marcha (dominios, CORS y Vercel): docs/CUENTA.md.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyADVBVjyLik8D54SLlE9-8jqkKV5JlRl_I
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=aether-app-59bd1.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=aether-app-59bd1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=aether-app-59bd1.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=462116144844
NEXT_PUBLIC_FIREBASE_APP_ID=1:462116144844:web:b1985be915ecbeffe36469
